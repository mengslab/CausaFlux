      "type": "string"
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "biospecimen_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_version": {
      "const": "causaflux-experiment-contract-1.0",
      "type": "string"
    },
    "cost_unit": {
      "type": "string"
    },
    "created_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
