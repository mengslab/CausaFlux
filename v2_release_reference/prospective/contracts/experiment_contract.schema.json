{
  "$id": "https://causaflux.local/contracts/experiment-contract-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
