  "required": [
    "contract_version",
    "study_id",
    "cycle_id",
    "experiment_id",
    "sample_id",
    "assay_type",
    "perturbation_type",
    "target",
    "dose",
    "dose_unit",
    "start_time",
    "duration",
    "time_unit",
    "sample_time",
    "replicate_id",
    "randomization_block",
    "expected_cost",
    "cost_unit",
    "model_freeze_id",
    "preregistration_id",
    "status"
