      "type": [
        "string",
        "null"
      ]
    },
    "model_freeze_id": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "operator": {
      "type": [
        "string",
        "null"
      ]
    },
    "perturbation_type": {
      "type": "string"
    },
    "plate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "preregistration_id": {
      "type": "string"
    },
    "protocol_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "randomization_block": {
      "type": "string"
    },
    "replicate_id": {
      "type": "string"
    },
    "sample_id": {
      "type": "string"
    },
    "sample_manifest_uri": {
      "type": [
        "string",
        "null"
      ]
    },
